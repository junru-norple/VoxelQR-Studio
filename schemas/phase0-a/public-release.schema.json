{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junru-norple/VoxelQR-Studio/schemas/phase0-a/public-release.schema.json",
  "title": "VoxelQR Studio public read-only release verification input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "repository", "version", "tag", "expectedTarget", "expectedReleaseTitle",
    "expectedReleaseState", "requiredReleaseNoteMarkers", "expectedManagedAssets", "expectedChecksum",
    "expectedReadme", "expectedLatest", "expectedAutomaticSourceArchiveCount"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "repository": { "type": "object" },
    "version": { "type": "string" },
    "tag": { "type": "string" },
    "expectedTarget": { "type": "object" },
    "expectedReleaseTitle": { "type": "string" },
    "expectedReleaseState": { "type": "object" },
    "requiredReleaseNoteMarkers": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "expectedManagedAssets": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "expectedChecksum": { "type": "object" },
    "expectedReadme": { "type": "object" },
    "expectedLatest": { "type": "boolean" },
    "expectedAutomaticSourceArchiveCount": { "const": 2 }
  }
}
