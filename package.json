{
  "name": "voxelqr-studio",
  "version": "1.1.0",
  "private": true,
  "description": "VoxelQR Studio — an offline-first dynamic 3D voxel QR Code generator for Windows and the web.",
  "author": "VoxelQR Studio contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:unit": "vitest run tests/unit",
    "test:qr": "vitest run tests/qr-decode.test.ts",
    "build:web": "vite build --emptyOutDir --outDir _workspace/build/v1.1.0-r6/web",
    "build:single": "vite build --emptyOutDir --config vite.single.config.ts --outDir _workspace/build/v1.1.0-r6/single",
    "build:acceptance": "npm run build:single && npm run build:windows && node scripts/build-acceptance.mjs",
    "build:windows-assets": "vite build --emptyOutDir --outDir _workspace/build/v1.1.0-r6/desktop",
    "build:windows": "npm run build:windows-assets && electron-builder --win portable --x64 --config electron-builder.yml",
    "preview:web": "vite preview --outDir _workspace/build/v1.1.0-r6/web --host 127.0.0.1 --port 4173",
    "preview:windows": "electron .",
    "validate:web": "node scripts/validate-web.mjs",
    "validate:export": "node scripts/validate-export-r6.mjs",
    "validate:motion": "node scripts/validate-r6-motion.mjs",
    "validate:single": "node scripts/validate-single.mjs",
    "validate:windows": "node scripts/validate-windows.mjs",
    "audit:licenses": "node scripts/license-audit.mjs",
    "validate:root-containment": "vitest run tests/root-containment.test.mjs",
    "validate:all": "npm run validate:root-containment && npm run lint && npm run typecheck && npm test && npm run build:web && npm run build:acceptance && npm run validate:web && npm run validate:motion && npm run validate:export && npm run validate:single && npm run validate:windows && npm run audit:licenses"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
